// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  googleId     String?    @unique

  posts        Post[]
  reqTrades    Trade[]     @relation("reqTrades")
  ownedTrades  Trade[]     @relation("ownedTrades")
  comments     Comment[]
  logs         Log[]
  products     Product[]
  services     Service[]
  initiatedDMs DM[]        @relation("initiatedDMs")
  recievedDMs  DM[]        @relation("recievedDMs")
  sMessages    Message[]   @relation("sMessages")
  rMessages    Message[]   @relation("rMessages")
  sReviews     Review[]    @relation("sReviews")
  rReviews     Review[]    @relation("rReviews")

  name         String
  email        String      @unique
  phone        String?
  role         Role?       @default(USER)
  bio          String?
  createdAt    DateTime    @default(now())
  zipCode      String?

  reportsFiled    Report[]  @relation("reportsFiled")
  reportsAgainst  Report[]  @relation("reportsAgainst")
  reportsResolved Report[]  @relation("reportsResolved")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model DM {
  id      Int  @id @default(autoincrement())
  user1   User @relation("initiatedDMs", fields: [user1Id], references: [id])
  user1Id Int
  user2   User @relation("recievedDMs", fields: [user2Id], references: [id])
  user2Id Int

  messages Message[]
}

model Message {
  id         Int  @id @default(autoincrement())
  dm         DM   @relation(fields: [dmId], references: [id])
  dmId       Int
  sender     User @relation("sMessages", fields: [senderId], references: [id])
  senderId   Int
  reciever   User @relation("rMessages", fields: [recieverId], references: [id])
  recieverId Int

  text String

  reports   Report[]
  isRemoved Boolean  @default(false)
}

model Log {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Post {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int

  products   Product[]
  services   Service[]
  comments   Comment[]
  trade      Trade?

  title       String
  message     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      String[]
  status      Status    @default(OPEN)

  isLocal     Boolean   @default(false)
  zipCode     String?
  radiusMiles Int?
  lat         Float?
  lng         Float?
  
  reports   Report[]
  isRemoved Boolean  @default(false)
}

enum Status {
  OPEN
  ACCEPTED
  IN_PROGRESS
  WAITING_FOR_OTHER_USER
  COMPLETED
  CANCELLED
}

model Trade {
  id          Int        @id @default(autoincrement())
  post        Post       @relation(fields: [postId], references: [id])
  postId      Int        @unique
  owner       User       @relation("ownedTrades", fields: [ownerId], references: [id])
  ownerId     Int
  requester   User       @relation("reqTrades", fields: [requesterId], references: [id])
  requesterId Int

  ownerCompl  Boolean    @default(false)
  reqCompl    Boolean    @default(false)
  status      Status     @default(IN_PROGRESS)
  reviews     Review[]
  createdAt   DateTime   @default(now())
}

model Comment {
  id          Int      @id @default(autoincrement())
  text        String
  createdAt   DateTime @default(now())

  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  user        User @relation(fields: [userId], references: [id])
  userId      Int
}

model Product {
  id          Int      @id @default(autoincrement())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  cat         Cat      @relation(fields: [catId], references: [id])
  catId       Int
  
  name        String
  description String?
  condition   Cond
  location    String?
}

enum Cond {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
  MINT
}

model Service {
  id          Int     @id @default(autoincrement())
  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  user        User    @relation(fields: [userId], references: [id])
  userId      Int
  cat         Cat     @relation(fields: [catId], references: [id])
  catId       Int

  name        String
  description String?
}

model Cat {
  id Int @id @default(autoincrement())

  products Product[]
  services Service[]

  type CatType
  name String  @unique
}

enum CatType {
  SERVICE
  PRODUCT
}

model Review {
  id         Int       @id @default(autoincrement())
  trade      Trade     @relation(fields: [tradeId], references: [id])
  tradeId    Int
  reviewer   User      @relation("sReviews", fields: [reviewerId], references: [id])
  reviewerId Int
  reviewee   User      @relation("rReviews", fields: [revieweeId], references: [id])
  revieweeId Int

  rating     Int
  comment    String?
  createdAt  DateTime   @default(now())

  @@unique([tradeId, reviewerId])
}

model Report {
  id         Int  @id @default(autoincrement())
  reporter   User @relation("reportsFiled", fields: [reporterId], references: [id])
  reporterId Int

  targetType   TargetType
  post         Post?      @relation(fields: [postId], references: [id])
  postId       Int?
  targetUser   User?      @relation("reportsAgainst", fields: [targetUserId], references: [id])
  targetUserId Int?
  message      Message?   @relation(fields: [messageId], references: [id])
  messageId    Int?

  reason  ReportReason
  details String?

  aiScore      Float?
  aiCategories String[]
  aiRationale  String?

  status     ReportStatus @default(PENDING)
  resolution String?
  resolver   User?        @relation("reportsResolved", fields: [resolverId], references: [id])
  resolverId Int?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

enum TargetType {
  POST
  USER
  MESSAGE
}

enum ReportReason {
  SPAM_OR_SCAM
  INAPPROPRIATE_CONTENT
  ITEM_MISMATCH
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  APPROVED
  REMOVED
}
