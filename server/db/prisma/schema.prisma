// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  googleId String? @unique

  posts        Post[]
  comments     Comment[]
  logs         Log[]
  products     Product[]
  services     Service[]
  tradeOffers  TradeOffer[]
  media        Media[]       
  userMedia    UserMedia[]   
  initiatedDMs DM[]           @relation("initiatedDMs")
  recievedDMs  DM[]           @relation("recievedDMs")
  sMessages    Message[]      @relation("sMessages")
  rMessages    Message[]      @relation("rMessages")
  rep          Rep[]

  name      String
  email     String   @unique
  phone     String?
  role      Role?    @default(USER)
  bio       String?
  createdAt DateTime @default(now())
  zipCode   String?

  reportsFiled    Report[] @relation("reportsFiled")
  reportsAgainst  Report[] @relation("reportsAgainst")
  reportsResolved Report[] @relation("reportsResolved")

  appealsFiled    Appeal[] @relation("appealsFiled")
  appealsResolved Appeal[] @relation("appealsResolved")

  blocksInitiated Block[] @relation("blocksInitiated")
  blocksReceived  Block[] @relation("blocksReceived")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model DM {
  id      Int  @id @default(autoincrement())
  user1   User @relation("initiatedDMs", fields: [user1Id], references: [id])
  user1Id Int
  user2   User @relation("recievedDMs", fields: [user2Id], references: [id])
  user2Id Int

  messages Message[]
}

model Message {
  id         Int  @id @default(autoincrement())
  dm         DM   @relation(fields: [dmId], references: [id])
  dmId       Int
  sender     User @relation("sMessages", fields: [senderId], references: [id])
  senderId   Int
  reciever   User @relation("rMessages", fields: [recieverId], references: [id])
  recieverId Int

  text String

  reports      Report[]
  isRemoved    Boolean        @default(false)
  messageMedia MessageMedia[]
}

model Log {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Post {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  products    Product[]
  services    Service[]
  comments    Comment[]
  tradeOffers TradeOffer[]
  postMedia   PostMedia[]

  title      String
  message    String
  isComplete Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  isLocal     Boolean @default(false)
  zipCode     String?
  radiusMiles Int?
  lat         Float?
  lng         Float?

  reports   Report[]
  isRemoved Boolean  @default(false)
}

enum TradeOfferStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

model TradeOffer {
  id        Int    @id @default(autoincrement())
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  offerer   User   @relation(fields: [offererId], references: [id], onDelete: Cascade)
  offererId Int
  message   String?

  tradeOfferMedia TradeOfferMedia[] 

  ownerApproved   Boolean          @default(false)
  offererApproved Boolean          @default(false)
  status          TradeOfferStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int
  user         User           @relation(fields: [userId], references: [id])
  userId       Int
  commentMedia CommentMedia[]
}

model Product {
  id          Int     @id @default(autoincrement())
  post        Post    @relation(fields: [postId], references: [id])
  postId      Int
  user        User    @relation(fields: [userId], references: [id])
  userId      Int
  cat         Cat     @relation(fields: [catId], references: [id])
  catId       Int

  name        String
  description String?
  condition   Cond
  location    String?

  productMedia ProductMedia[]
}

enum Cond {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
  MINT
}

model Service {
  id          Int     @id @default(autoincrement())
  post        Post    @relation(fields: [postId], references: [id])
  postId      Int
  user        User    @relation(fields: [userId], references: [id])
  userId      Int
  cat         Cat     @relation(fields: [catId], references: [id])
  catId       Int

  name        String
  description String?

  serviceMedia ServiceMedia[]
}

model Cat {
  id Int @id @default(autoincrement())

  products Product[]
  services Service[]

  type CatType
  name String  @unique
}

enum CatType {
  SERVICE
  PRODUCT
  DIGITAL
}

model Rep {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Block {
  id Int @id @default(autoincrement())

  blocker   User @relation("blocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId Int
  blocked   User @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId Int

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         Int  @id @default(autoincrement())
  reporter   User @relation("reportsFiled", fields: [reporterId], references: [id])
  reporterId Int

  targetType   TargetType
  post         Post?    @relation(fields: [postId], references: [id])
  postId       Int?
  targetUser   User?    @relation("reportsAgainst", fields: [targetUserId], references: [id])
  targetUserId Int?
  message      Message? @relation(fields: [messageId], references: [id])
  messageId    Int?

  reason  ReportReason
  details String?

  aiScore      Float?
  aiCategories String[]
  aiRationale  String?

  status     ReportStatus @default(PENDING)
  resolution String?
  resolver   User?        @relation("reportsResolved", fields: [resolverId], references: [id])
  resolverId Int?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  appeal Appeal?

  @@index([status, createdAt])
}

model Appeal {
  id Int @id @default(autoincrement())

  report   Report @relation(fields: [reportId], references: [id])
  reportId Int    @unique

  appellant   User @relation("appealsFiled", fields: [appellantId], references: [id])
  appellantId Int

  message String

  status     AppealStatus @default(PENDING)
  resolution String?
  resolver   User?        @relation("appealsResolved", fields: [resolverId], references: [id])
  resolverId Int?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

enum AppealStatus {
  PENDING
  GRANTED
  DENIED
}

enum TargetType {
  POST
  USER
  MESSAGE
}

enum ReportReason {
  SPAM_OR_SCAM
  INAPPROPRIATE_CONTENT
  ITEM_MISMATCH
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  APPROVED
  REMOVED
}

enum MediaVariant {
  PREVIEW
  FULL
}

model Media {
  id     Int    @id @default(autoincrement())
  s3Key  String @unique 

  uploader   User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId Int

  variant   MediaVariant? 
  createdAt DateTime       @default(now())

  postMedia       PostMedia[]
  tradeOfferMedia TradeOfferMedia[]
  productMedia    ProductMedia[]
  serviceMedia    ServiceMedia[]
  commentMedia    CommentMedia[]
  messageMedia    MessageMedia[]
  userMedia       UserMedia[]
}

model PostMedia {
  id        Int   @id @default(autoincrement())
  media     Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  post      Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  sortOrder Int   @default(0)

  @@unique([mediaId, postId])
}

model TradeOfferMedia {
  id           Int        @id @default(autoincrement())
  media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId      Int
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  tradeOfferId Int
  sortOrder    Int        @default(0)

  @@unique([mediaId, tradeOfferId])
}

model ProductMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([mediaId, productId])
}

model ServiceMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId Int

  @@unique([mediaId, serviceId])
}

model CommentMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int

  @@unique([mediaId, commentId])
}

model MessageMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId Int

  @@unique([mediaId, messageId])
}

model UserMedia {
  id      Int   @id @default(autoincrement())
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  @@unique([mediaId, userId])
}