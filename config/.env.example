// MODE should be set to development locally or production when deployed
// DATABASE URL should be set to postgresql://[YOUR_USERNAME_HERE]:[YOUR_PASSWORD_HERE]@localhost:5432/[YOUR_DATABASE_HERE]

MODE=development_or_production

DATABASE_URL

CLIENT_URL

GOOGLE_CLIENT_ID

GOOGLE_CLIENT_SECRET

GOOGLE_CALLBACK_URL

SESSION_SECRET

GEMINI_API_KEY

AWS_REGION

AWS_ACCESS_KEY_ID

AWS_SECRET_ACCESS_KEY

AWS_S3_BUCKET_NAME

GEOAPIFY_API_KEY

RESEND_API_KEY

CONTACT_EMAILS

CONTACT_FROM_EMAIL

SKIP_SCREENING=true_or_false

// SKIP_SCREENING set to true during development to avoid spending from API request quota
//  set to false when ready to test Gemini or deploy
